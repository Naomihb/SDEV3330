{
  "name": "sprintsim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --config jest.config.cjs --coverage",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:ci": "jest --config jest.config.cjs --coverage --ci --forceExit",
    "test:integration": "cd tests/integration && pytest -v --tb=short",
    "test:integration:local": "pytest tests/integration -v --tb=short -c tests/integration/pytest.ini"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.50.0",
    "clsx": "^2.1.1",
    "next": "14.2.15",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/jest": "^29",
    "@testing-library/react": "^15",
    "@testing-library/jest-dom": "^6",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29",
    "typescript": "^5"
  }
}
